# Variables d'environnement — copier vers .env.local et remplir.
# Sans ces valeurs, l'app tourne en mode démo (données mockées).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cotes serveur (Edge Functions uniquement, jamais exposees au client) :
#   SUPABASE_SERVICE_ROLE_KEY=

# --- Connexion sociale (optionnelle) -------------------------------
# Laisser vide = le bouton correspondant ne s'affiche pas.
# Les SECRETS ne vont PAS ici : ils se definissent dans
# Supabase > Edge Functions > Secrets (voir supabase/functions/*/index.ts).

# TikTok — Login Kit, ouvert a tous les comptes.
# https://developers.tiktok.com > ton app > Login Kit
VITE_TIKTOK_CLIENT_KEY=
VITE_TIKTOK_REDIRECT_URI=https://viralnight-pwa.vercel.app/

# Instagram — n'accepte QUE les comptes Createur ou Business.
# https://developers.facebook.com > ton app > Instagram > API setup
VITE_INSTAGRAM_APP_ID=
VITE_INSTAGRAM_REDIRECT_URI=https://viralnight-pwa.vercel.app/
